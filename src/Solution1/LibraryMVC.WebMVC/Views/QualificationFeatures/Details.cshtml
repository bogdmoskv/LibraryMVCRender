@model LibraryMVC.Domain.Entities.QualificationFeature

@{
    ViewData["Title"] = "Ознака";
}

<h2>@Model.Name</h2>

<p class="text-muted">
    @(Model.Description ?? "-")
</p>

<h5>Видання</h5>
@if (Model.Books != null && Model.Books.Any())
{
    <ul>
        @foreach (var b in Model.Books)
        {
            <li>@b.Title</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Немає пов'язаних видань.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Змінити</a>
    <a asp-action="Index" class="btn btn-link">Назад</a>
</div>