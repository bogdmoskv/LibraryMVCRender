@model IEnumerable<LibraryMVC.Domain.Entities.QualificationFeature>

@{
    ViewData["Title"] = "Кваліфікаційні ознаки";
}

<h2>Кваліфікаційні ознаки видань</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Створити</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Опис</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Description ?? "-")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Деталі</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Змінити</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>