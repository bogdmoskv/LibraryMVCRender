@model LibraryMVC.WebMVC.Models.LoanForm

@{
    ViewData["Title"] = "Редагування видачі";
}

<h2>Редагувати видачу</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="BookId" class="form-label">Видання</label>
        <select asp-for="BookId" class="form-select js-lookup" asp-items="ViewBag.BookId"
                data-lookup-url="@Url.Action("Books", "Lookup")"></select>
        <div class="form-text">Пошук від 3 символів, варіанти завантажуються з сервера.</div>
    </div>

    <div class="mb-3">
        <label asp-for="ReaderId" class="form-label">Читач</label>
        <select asp-for="ReaderId" class="form-select js-lookup" asp-items="ViewBag.ReaderId"
                data-lookup-url="@Url.Action("Readers", "Lookup")"></select>
        <div class="form-text">Пошук від 3 символів, варіанти завантажуються з сервера.</div>
    </div>

    <div class="mb-3">
        <label asp-for="LoanDate" class="form-label">Дата видачі</label>
        <input asp-for="LoanDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label">Повернути до</label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ReturnDate" class="form-label">Дата повернення</label>
        <input asp-for="ReturnDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-link">Назад</a>
</form>

@section Head {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
}
@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/autocomplete-select.js" asp-append-version="true"></script>
}