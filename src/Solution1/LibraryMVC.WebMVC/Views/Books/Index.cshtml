@model IEnumerable<LibraryMVC.Domain.Entities.Book>

@{
    ViewData["Title"] = "Видання";
}

<h2>Фонд видань</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Створити</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Рік</th>
                <th>Файл</th>
                <th>Автори</th>
                <th>Ознаки</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.PublicationYear</td>
                    <td>
                        @if (string.IsNullOrEmpty(item.CoverPath))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <a href="@item.CoverPath" target="_blank">файл</a>
                        }
                    </td>
                    <td>@string.Join(", ", item.Authors.Select(a => a.FullName))</td>
                    <td>@string.Join(", ", item.Features.Select(a => a.Name))</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Деталі</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Змінити</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>