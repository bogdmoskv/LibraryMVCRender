@model LibraryMVC.WebMVC.Models.ReaderForm

@{
    ViewData["Title"] = "Редагування читача";
}

<h2>Редагувати читача</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">П.І.Б.</label>
        <input asp-for="FullName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Faculty" class="form-label">Факультет</label>
        <input asp-for="Faculty" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Department" class="form-label">Кафедра</label>
        <input asp-for="Department" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Position" class="form-label">Посада</label>
        <input asp-for="Position" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-link">Назад</a>
</form>