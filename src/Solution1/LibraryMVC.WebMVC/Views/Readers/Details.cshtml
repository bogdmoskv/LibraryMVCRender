@model LibraryMVC.Domain.Entities.Reader

@{
    ViewData["Title"] = "Читач";
}

<h2>@Model.FullName</h2>

<dl class="row">
    <dt class="col-sm-3">Факультет</dt>
    <dd class="col-sm-9">@Model.Faculty</dd>

    <dt class="col-sm-3">Кафедра</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Посада</dt>
    <dd class="col-sm-9">@Model.Position</dd>

    <dt class="col-sm-3">Зареєстровано</dt>
    <dd class="col-sm-9">@Model.RegisteredAt.ToLocalTime().ToString("g")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Змінити</a>
    <a asp-action="Index" class="btn btn-link">Назад</a>
</div>