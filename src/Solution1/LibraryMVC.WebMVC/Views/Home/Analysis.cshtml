@{
    ViewData["Title"] = "Аналіз";
}

<h2>Аналіз складу читачів і фондів</h2>
<p class="text-muted">Діаграми побудовано бібліотекою Chart.js за даними фонду, читачів і видач</p>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Фонд за роками видання</h5>
                <div class="chart-box chart-box-full">
                    <canvas id="booksByYearChart" aria-label="Стовпчикова діаграма фонду за роками видання"></canvas>
                    <p class="chart-empty d-none"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Читачі за факультетами</h5>
                <div class="chart-box chart-box-full">
                    <canvas id="readersByFacultyChart" aria-label="Кругова діаграма читачів за факультетами"></canvas>
                    <p class="chart-empty d-none"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Читачі за кафедрами</h5>
                <div class="chart-box chart-box-full">
                    <canvas id="readersByDepartmentChart" aria-label="Кільцева діаграма читачів за кафедрами"></canvas>
                    <p class="chart-empty d-none"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Динаміка видач по місяцях</h5>
                <div class="chart-box chart-box-full">
                    <canvas id="loansByMonthChart" aria-label="Лінійний графік видач по місяцях"></canvas>
                    <p class="chart-empty d-none"></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/library-charts.js" asp-append-version="true"></script>
    <script>
        LibraryCharts.bar("booksByYearChart", "/api/Charts/booksByYear", "year", "count", "Видань", "Рік видання", "Кількість", false, false);
        LibraryCharts.pie("readersByFacultyChart", "/api/Charts/readersByFaculty", "name", "count", false, false);
        LibraryCharts.pie("readersByDepartmentChart", "/api/Charts/readersByDepartment", "name", "count", false, true);
        LibraryCharts.line("loansByMonthChart", "/api/Charts/loansByMonth", "month", "count", "Видач", "Місяць", "Кількість", false);
    </script>
}
