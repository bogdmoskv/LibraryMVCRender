@{
    ViewData["Title"] = "Аналіз";
}

<h2>Аналіз складу читачів і фондів</h2>
<p class="text-muted">Діаграми побудовано за допомогою Google Charts</p>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Фонд за роками видання</h5>
                <div id="booksByYearChart" style="width:100%; height:320px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Читачі за факультетами</h5>
                <div id="readersByFacultyChart" style="width:100%; height:320px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Читачі за кафедрами</h5>
                <div id="readersByDepartmentChart" style="width:100%; height:320px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h5 class="card-title">Динаміка видач по місяцях</h5>
                <div id="loansByMonthChart" style="width:100%; height:320px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(drawAll);

        async function fetchJson(url) {
            const response = await fetch(url);
            return await response.json();
        }

        async function drawAll() {
            await Promise.all([
                drawColumnChart('/api/Charts/booksByYear', 'booksByYearChart', 'Рік', 'Кількість видань', 'year', 'count'),
                drawPieChart('/api/Charts/readersByFaculty', 'readersByFacultyChart', 'Факультет', 'name', 'count'),
                drawPieChart('/api/Charts/readersByDepartment', 'readersByDepartmentChart', 'Кафедра', 'name', 'count'),
                drawColumnChart('/api/Charts/loansByMonth', 'loansByMonthChart', 'Місяць', 'Кількість видач', 'month', 'count')
            ]);
        }

        async function drawColumnChart(url, elementId, xTitle, yTitle, xKey, yKey) {
            const dataRows = await fetchJson(url);
            const data = new google.visualization.DataTable();
            data.addColumn('string', xTitle);
            data.addColumn('number', yTitle);
            dataRows.forEach(item => {
                const x = item[xKey] ?? item[xKey.charAt(0).toUpperCase() + xKey.slice(1)] ?? Object.values(item)[0];
                const y = item[yKey] ?? item[yKey.charAt(0).toUpperCase() + yKey.slice(1)] ?? Object.values(item)[1];
                data.addRow([String(x), Number(y)]);
            });
            const chart = new google.visualization.ColumnChart(document.getElementById(elementId));
            chart.draw(data, { legend: { position: 'none' }, height: 320 });
        }

        async function drawPieChart(url, elementId, title, nameKey, countKey) {
            const dataRows = await fetchJson(url);
            const data = new google.visualization.DataTable();
            data.addColumn('string', title);
            data.addColumn('number', 'Кількість');
            dataRows.forEach(item => {
                const name = item[nameKey] ?? item.Name ?? Object.values(item)[0];
                const count = item[countKey] ?? item.Count ?? Object.values(item)[1];
                data.addRow([String(name), Number(count)]);
            });
            const chart = new google.visualization.PieChart(document.getElementById(elementId));
            chart.draw(data, { title: title, height: 320 });
        }
    </script>
}
