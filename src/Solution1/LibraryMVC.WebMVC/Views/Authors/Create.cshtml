@model LibraryMVC.WebMVC.Models.AuthorForm

@{
    ViewData["Title"] = "Новий автор";
}

<h2>Створити автора</h2>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">П.І.Б.</label>
        <input asp-for="FullName" class="form-control" required/>
    </div>

    <div class="mb-3">
        <label class="form-label">Біографія</label>
        <textarea asp-for="Biography" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}